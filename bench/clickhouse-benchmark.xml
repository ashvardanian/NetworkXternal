<clickhouse>
    <!-- A benchmark container is thrown away after the run, and its own logs otherwise fill the ramdisk
         it shares with the data: 700 MB of `system.query_log` was enough to slow every query down. -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <part_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <session_log remove="1"/>
    <logger>
        <level>warning</level>
    </logger>
</clickhouse>
