# Python bytecode, build products and environments
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Datasets are symlinks into the shared filesystem, never copies in the repository
data/*
!data/.gitkeep

# Local databases and benchmark output
*.db3
*.sqlite3
bench/results/

# Editors and platforms
.vscode/
.DS_Store
